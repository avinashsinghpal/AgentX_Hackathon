# SellerResolve Backend Environment Variables
ENV=development
DEBUG=true

# Cryptographic Keys (HMAC-SHA256, Session Tokens, Argon2id)
# Required outside development/testing; must be at least 32 characters.
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production

# Database
# PostgreSQL is the default runtime database (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://sellerresolve:sellerresolve_local_password@localhost:5432/sellerresolve
# SQLite is still supported for local experiments and is used by the test suite:
# DATABASE_URL=sqlite:///./sellerresolve.db

# Connection pool (ignored for SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_USE_NULL_POOL=false
DB_ECHO=false

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Sessions
SESSION_EXPIRY_SECONDS=604800
SESSION_IDLE_SECONDS=86400

# File Uploads
MAX_UPLOAD_BYTES=5242880
UPLOAD_DIR=./uploads

# Demo Data Seeding
SEED_DEMO=true

# LLM Providers (optional; uses FakeLLMClient with grounded responses when empty)
LLM_PROVIDER=fake
LLM_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Proactive Delay Monitor
PROACTIVE_MONITOR_INTERVAL_MINUTES=60
