# Environment Mode (development | production | test)
ENV=development
DEBUG=true

# Security
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production

# Database (SQLite for prototype; PostgreSQL connection string for production)
DATABASE_URL=sqlite:///./sellerresolve.db

# Frontend API Proxy URL
API_PROXY_URL=http://127.0.0.1:8000/api/:path*

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Sessions
SESSION_EXPIRY_SECONDS=604800
SESSION_IDLE_SECONDS=86400

# File Uploads
MAX_UPLOAD_BYTES=5242880
UPLOAD_DIR=./uploads

# Demo Data Seeding (permitted only when ENV != production)
SEED_DEMO=true

# Anthropic LLM Integration (optional in dev, falls back to FakeLLMClient when absent)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Outbound Notifications (SMTP optional; in-app notifications used when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Background Scheduler
PROACTIVE_MONITOR_INTERVAL_MINUTES=60

